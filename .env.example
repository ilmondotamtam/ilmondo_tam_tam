# =============================================================================
# ARUBA BUSINESS MYSQL PHP BRIDGE & AUTH CONFIGURATION
# =============================================================================
# URL dell'endpoint bridge.php caricato nel tuo spazio web Aruba Business:
# Es: https://www.tuodominioaruba.it/aruba-bridge/bridge.php
ARUBA_BRIDGE_URL='https://www.tuodominioaruba.it/aruba-bridge/bridge.php'

# Chiave segreta condivisa tra l'applicazione Node.js e bridge.php su Aruba:
# Deve corrispondere esattamente alla chiave impostata in aruba-bridge/config.php
ARUBA_BRIDGE_KEY='TAM_TAM_ARUBA_BRIDGE_KEY_2026'

# Imposta a 'true' se l'app gira direttamente su hosting Aruba (connessione diretta MySQL), 'false' per usare PHP Bridge
IS_ARUBA_HOSTING='false'

# Parametri opzionali per connessione MySQL interna o script di setup
MYSQL_HOST='127.0.0.1'
MYSQL_PORT=3306
MYSQL_DATABASE='SqlXXXXXX_1'
MYSQL_USER='SqlXXXXXX'
MYSQL_PASSWORD=''

# =============================================================================
# ARUBA BUSINESS MEDIA STORAGE (SSH / SFTP per immagini e video)
# =============================================================================
ARUBA_MEDIA_BASE_URL='https://www.tuodominioaruba.it'
ARUBA_SSH_HOST='tuodominioaruba.it'
ARUBA_SSH_USER='tuo_utente_ssh'
ARUBA_SSH_PASSWORD='tua_password_ssh'
ARUBA_SSH_PORT=22
ARUBA_SSH_ROOT_PATH=''
ARUBA_SSH_PRIVATE_KEY=''
ARUBA_SSH_PASSPHRASE=''
