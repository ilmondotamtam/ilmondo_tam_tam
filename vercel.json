{
  "version": 2,
  "builds": [
    { "src": "aruba-bridge/bridge.php", "use": "vercel-php" },
    { "src": "reset-password.php", "use": "vercel-php" },
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist" } }
  ],
  "rewrites": [
    { "source": "/api/bridge", "destination": "/aruba-bridge/bridge.php" },
    { "source": "/api/bridge.php", "destination": "/aruba-bridge/bridge.php" },
    { "source": "/aruba-bridge/bridge.php", "destination": "/aruba-bridge/bridge.php" },
    { "source": "/reset-password.php", "destination": "/reset-password.php" },
    { "source": "/((?!api/|aruba-bridge/|reset-password\\.php|assets/).*)", "destination": "/index.html" }
  ]
}
