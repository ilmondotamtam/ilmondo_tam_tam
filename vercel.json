{
  "version": 2,
  "functions": {
    "api/bridge.php": {
      "runtime": "vercel-php"
    }
  },
  "rewrites": [
    { "source": "/api/bridge", "destination": "/api/bridge.php" },
    { "source": "/api/(.*)", "destination": "/server.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
